# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional for a compatible local gateway. Do not deploy a localhost URL to Vercel.
ANTHROPIC_BASE_URL=
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.5

# Research: Tavily is preferred; OpenAI web search is the automatic fallback.
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=
GITHUB_TOKEN=

# Crawl4AI is self-hosted. Use a public HTTPS endpoint in production.
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=

# Strongly recommended for every public deployment. Protects paid generation APIs.
STORYLAB_ACCESS_CODE=
